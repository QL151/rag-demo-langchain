# ===================== 复制成 .env 后填写 =====================
# 无Key可启动并摘录资料；真实问答配置聊天Key，真实语义检索另配embedding模型与Key。
# API地址请按实际账号、地域/工作空间填写，以下保留原项目示例。

# ---------- 生成回答用的大模型 ----------
# DeepSeek（便宜、中文好，推荐学生用）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 备选：通义千问（阿里云百炼）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 备选：硅基流动（一个 Key 同时提供对话和 embedding，最省事）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60

# ---------- 向量化 ----------
# local：零依赖，开箱即用，效果一般（哈希词袋），适合先把流程跑通
# api  ：调用真实 embedding 模型，效果明显更好，正式演示请用这个
EMBEDDING_MODE=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BATCH_SIZE=10
LOCAL_EMBEDDING_DIM=1024
# 用硅基流动的话（一个 Key 搞定两件事）：
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 向量库 ----------
# chroma：通过 langchain-chroma 使用本地Chroma，安装 requirements-chroma.txt
# memory：内置纯 Python 实现（装不上 chromadb 时用这个）
VECTOR_BACKEND=chroma
CHROMA_DIR=data/chroma
MEMORY_INDEX_FILE=data/memory_index.json

# ---------- 存储 ----------
UPLOAD_DIR=data/uploads
DB_PATH=data/app.db
TRACE_DIR=data/traces

# ---------- RAG 参数（面试会被问，改了要能解释为什么）----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
MAX_CONTEXT_CHARS=6000
MAX_HISTORY_TURNS=5

# ---------- 混合检索：BM25 + 向量 + RRF + 精排 ----------
# 每一路召回多少条候选（融合前的池子）。
# 为什么不是 4：召回和精排要分开，池子太小精排没有发挥空间。
RETRIEVE_K=20
HYBRID_ENABLED=true
# RRF 的平滑常数，论文经验值 60：只吃名次不吃分数，所以不用调权重
RRF_K=60

# 精排（rerank）：把"召回 20 条"精排成"最相关的 4 条"。
# provider 取值：
#   auto —— 优先 cross-encoder（http），不可用时自动降级为 listwise（用对话模型排序）
#   http —— 只用 cross-encoder 接口
#   llm  —— 只用对话模型做 listwise 精排（只要 LLM_API_KEY 就能用）
#   off  —— 关闭精排
RERANK_ENABLED=true
RERANK_PROVIDER=auto
RERANK_API_KEY=
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=gte-rerank-v2
RERANK_CANDIDATES=20
# listwise 精排：cross-encoder 用不了时，把候选编号交给对话模型让它排序。
# 它给的是顺序不是分数，所以拒答阈值仍然按向量分判定（见 app/retrieval.py 的说明）。
RERANK_LLM_FALLBACK=true
RERANK_LLM_MAX_DOCS=12

# ---------- 拒答阈值：相关性检查，不能保证消除幻觉 ----------
# ⚠️ 这两个值**必须按你的语料标定**，不能照抄：
#     python scripts/calibrate_threshold.py
# 它会用一组"与语料无关"的探针问题测出"不该答的问题能拿到的最高分"，
# 再对照"该答对的问题的最低分"，给出建议值。
#
# 此处默认阈值沿用原版。切分器或向量模型改变后，应重新用自己的语料标定。
# cross-encoder可按精排分数判断；listwise只有排序，仍参考向量/关键词规则。
MIN_RERANK_SCORE=0.30
MIN_VECTOR_SCORE=0.40
# 关键词"强命中"豁免阈值的相对门槛（见 app/retrieval.py 的说明）
MIN_BM25_IDF_RATIO=0.6

# ---------- 多轮查询改写 ----------
# 打开后，"那学生呢？"会被改写成"学生版多少钱？"再送去检索。
# 代价是每次提问多一次模型调用（第一轮不需要，会自动跳过）。
REWRITE_ENABLED=true

# ---------- 成本计量（请按你实际的服务商价格改）----------
# 以下仅为费用估算配置示例，请按实际供应商和模型价格填写
PRICE_PROMPT_PER_1K=0.002
PRICE_COMPLETION_PER_1K=0.008

# ---------- 答案缓存 ----------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
# 语义缓存阈值：问题向量相似度超过它就直接复用答案（1.0 = 只用精确匹配）
CACHE_SEMANTIC_THRESHOLD=0.95
CACHE_MAX_SCAN=500

# ---------- 治理 ----------
# 留空 = 不鉴权（本地开发）；填上之后写操作需要请求头 X-API-Key
API_KEY=
# 上线必须收窄成具体域名，例如：CORS_ORIGINS=https://kb.your-company.com
CORS_ORIGINS=*
TRACE_ENABLED=true
TRACE_MEMORY_SIZE=200
# 上传文档时没指定部门时的默认值
DEFAULT_DEPT=public

# 供应商不支持stream_options/include_usage时可关闭；关闭后token可能为估算值。
STREAM_USAGE=true
